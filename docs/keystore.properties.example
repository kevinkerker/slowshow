# Vorlage für src-tauri/gen/android/app/keystore.properties
#
# Diese Datei ist versioniert und enthält **keine** Passwörter. Die echte Datei
# liegt unter src-tauri/gen/ und ist gitignored — sie verschwindet bei einem
# `tauri android init` und wird aus dieser Vorlage neu angelegt:
#
#   copy docs\keystore.properties.example src-tauri\gen\android\app\keystore.properties
#
# Danach die vier Werte eintragen. Ohne die Datei heißt das Ergebnis
# `app-universal-release-unsigned.apk` und lässt sich weder installieren noch
# veröffentlichen (RB-03, siehe docs/signing.md).

# Pfad zur Schlüsseldatei, mit VORWÄRTSSCHRÄGSTRICHEN — auch unter Windows.
# Gradle liest die Datei als Java-Properties, dort ist der Rückstrich ein
# Fluchtzeichen: `C:\Users\...` würde falsch aufgelöst.
storeFile=C:/Users/DEINNAME/Documents/slowshow.keystore

# Der Alias aus `keytool -alias`.
keyAlias=slowshow

# Bei PKCS12 — dem Format, das keytool seit Java 9 erzeugt — sind beide
# Passwörter in aller Regel identisch.
storePassword=
keyPassword=
